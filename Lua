-- ========== SERVICES / REFS ==========
local function HRP(c)
	return c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
end

local function getNet()
	local m = ReplicatedStorage:FindFirstChild("Modules")
	return m and m:FindFirstChild("Net")
end

local function dungeonRF()
	local net = getNet()
	return net and (net:FindFirstChild("RF/DungeonNPCNetworkFunction") or net:FindFirstChild("DungeonNPCNetworkFunction"))
end

local function noclip(on)
	local c = Player.Character
	if not c then return end
	for _, p in pairs(c:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = not on end
	end
end

-- Quantum-style tween (fly to position)
local function topos(cf)
	local hrp = HRP(Player.Character)
	if not hrp then return end
	noclip(true)
	local goal = typeof(cf) == "CFrame" and cf or CFrame.new(cf)
	local speed = math.max(G.TweenSpeed or 250, 50)
	local dist = (hrp.Position - goal.Position).Magnitude
	local step = speed / 60
	if dist > 3 then
		hrp.CFrame = CFrame.new(
			hrp.Position + (goal.Position - hrp.Position).Unit * math.min(dist, step),
			goal.Position
		)
	else
		hrp.CFrame = goal
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
end

local function equipWeapon()
	local kind = G.Weapon or "Melee"
	local char = Player.Character
	if not char then return nil end
	local function match(t)
		local tip = tostring(t.ToolTip or "")
		local n = string.lower(t.Name)
		if kind == "Fruit" then return tip == "Blox Fruit" or n:find("fruit")
		elseif kind == "Gun" then return tip == "Gun"
		elseif kind == "Sword" then return tip == "Sword"
		else return tip == "Melee" or tip == "Combat" end
	end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and match(t) then return t end
	end
	for _, t in ipairs(Player.Backpack:GetChildren()) do
		if t:IsA("Tool") and match(t) then
			t.Parent = char
			return t
		end
	end
	return nil
end

local function autoHaki()
	pcall(function()
		local c = ReplicatedStorage:FindFirstChild("Remotes")
		if c and c:FindFirstChild("CommF_") then
			c.CommF_:InvokeServer("Buso")
		end
	end)
end

local function attack(target)
	if not target or not target.Parent then return end
	local part = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
	if not part then return end
	local tool = equipWeapon()
	if tool then
		local mp = tool:FindFirstChild("MousePos")
		if mp and mp:IsA("Vector3Value") then mp.Value = part.Position end
		pcall(function() tool:Activate() end)
	end
	local Net = getNet()
	local RA = Net and Net:FindFirstChild("RE/RegisterAttack")
	local RH = Net and Net:FindFirstChild("RE/RegisterHit")
	if RA and RH then
		pcall(function()
			RA:FireServer(0.01)
			RH:FireServer(target:FindFirstChild("Head") or part, {{target, part}})
		end)
	end
end

-- ========== QUANTUM DUNGEON HELPERS ==========
local function getDungeon()
	local map = Workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Dungeon")
end

-- fn31: current floor by XZ distance inside extents
local function getCurrentFloor()
	local dungeon = getDungeon()
	if not dungeon then return nil, 0 end
	local hrp = HRP(Player.Character)
	if not hrp then return nil, 0 end
	local pos = hrp.Position
	local best, bestDist, idx = nil, math.huge, 0
	for i = 1, 100 do
		local floor = dungeon:FindFirstChild(tostring(i))
		if floor then
			local ok, pivot = pcall(function() return floor:GetPivot().Position end)
			local ok2, extents = pcall(function() return floor:GetExtentsSize() end)
			if ok and pivot then
				local d = math.sqrt((pos.X - pivot.X) ^ 2 + (pos.Z - pivot.Z) ^ 2)
				local radius = 300
				if ok2 and extents then
					radius = math.max(extents.X, extents.Z) / 2 + 300
				end
				if d < radius and d < bestDist then
					bestDist = d
					best = floor
					idx = i
				end
			end
		end
	end
	return best, idx
end

-- fn32: enemies on floor
local function getFloorEnemies(floor)
	local list = {}
	if not floor then return list end
	local ok, pivot = pcall(function() return floor:GetPivot().Position end)
	local ok2, extents = pcall(function() return floor:GetExtentsSize() end)
	if not ok then return list end
	local radius = 300
	if ok2 and extents then
		radius = math.max(extents.X, extents.Z) / 2 + 300
	end
	local en = Workspace:FindFirstChild("Enemies")
	if not en then return list end
	for _, child in ipairs(en:GetChildren()) do
		local hum = child:FindFirstChild("Humanoid") or child:FindFirstChildOfClass("Humanoid")
		local r = child:FindFirstChild("HumanoidRootPart")
		if hum and hum.Health > 0 and r and child.Name ~= "Blank Buddy"
			and not string.find(string.lower(child.Name), "shadow") then
			local d = math.sqrt((pivot.X - r.Position.X) ^ 2 + (pivot.Z - r.Position.Z) ^ 2)
			if d < radius then
				table.insert(list, child)
			end
		end
	end
	return list
end

-- GetDungeonProps
local function getDungeonProps(floor)
	if not floor or not floor:FindFirstChild("Props") then return nil end
	for _, p in ipairs(floor.Props:GetChildren()) do
		if p:GetAttribute("KitsuneMarkActive") == true or p:GetAttribute("Speed") == 5 then
			return p
		end
	end
	return nil
end

-- GetDungeonIslands (exit teleporter to next floor)
local function getDungeonExit()
	local dungeon = getDungeon()
	if not dungeon then return nil end
	local hrp = HRP(Player.Character)
	if not hrp then return nil end
	local best, bestDist, idx = nil, math.huge, 0
	for i = 1, 100 do
		local floor = dungeon:FindFirstChild(tostring(i))
		if floor then
			local ok, pivot = pcall(function() return floor:GetPivot().Position end)
			local ok2, extents = pcall(function() return floor:GetExtentsSize() end)
			if ok and pivot then
				local mag = (hrp.Position - pivot).Magnitude
				local radius = 100
				if ok2 and extents then
					radius = math.max(extents.X, extents.Y, extents.Z) / 2 + 100
				end
				if mag < radius and mag < bestDist then
					bestDist = mag
					best = floor
					idx = i
				end
			end
		end
	end
	if not best then return nil end
	if not dungeon:FindFirstChild(tostring(idx + 1)) then return nil end
	if best:FindFirstChild("ExitTeleporter") and best.ExitTeleporter:FindFirstChild("Root") then
		return best.ExitTeleporter.Root
	end
	return nil
end

local function bringEnemies(centerTarget)
	if not G.Bring then return end
	local center = centerTarget and (centerTarget:FindFirstChild("HumanoidRootPart") or centerTarget.PrimaryPart)
	if not center then return end
	local en = Workspace:FindFirstChild("Enemies")
	if not en then return end
	for _, e in ipairs(en:GetChildren()) do
		local h = e:FindFirstChildOfClass("Humanoid")
		local r = e:FindFirstChild("HumanoidRootPart")
		if h and h.Health > 0 and r and e ~= centerTarget then
			if (r.Position - center.Position).Magnitude <= 250 then
				r.CFrame = center.CFrame * CFrame.new(0, -2, 0)
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end
end

local function tpDungeonHub()
	pcall(function()
		local rf = dungeonRF()
		if rf then
			rf:InvokeServer("TeleportToDungeonHub", false)
		end
	end)
	-- fallback yellow server button style remote attempts
	pcall(function()
		local net = getNet()
		if net then
			for _, name in ipairs({
				"RF/DungeonNPCNetworkFunction",
				"DungeonNPCNetworkFunction",
			}) do
				local r = net:FindFirstChild(name)
				if r then
					pcall(function() r:InvokeServer("TeleportToDungeonHub", false) end)
					pcall(function() r:InvokeServer("TeleportToDungeonHub") end)
				end
			end
		end
	end)
end

local function selectCards()
	local selection = G.SelectedCard
	if not selection then return end
	local list = type(selection) == "table" and selection or { selection }
	if #list == 0 then return end
	for _, descendant in ipairs(Player.PlayerGui:GetDescendants()) do
		if descendant:IsA("TextLabel") and descendant.Name == "DisplayName" and descendant.Text then
			local text = string.lower(descendant.Text:gsub("<[^>]+>", ""))
			for _, card in ipairs(list) do
				if string.find(text, string.lower(card)) then
					local parent = descendant.Parent
					if parent and parent.Activated then
						pcall(function() firesignal(parent.Activated) end)
						return true
					end
					if parent and parent:IsA("GuiButton") then
						pcall(function() firesignal(parent.MouseButton1Click) end)
						return true
					end
				end
			end
		end
	end
end

-- ========== LOOPS (Quantum AutoDungeonFull) ==========
local lastFloorIdx = 0

task.spawn(function()
	while true do
		if G.AutoDungeon then
			local dungeon = getDungeon()
			if dungeon then
				local floor, floorIdx = getCurrentFloor()
				local enemies = getFloorEnemies(floor)

				-- Auto Destroy Events (shrines/vents) when same floor
				if G.AutoDestroy and floorIdx == lastFloorIdx then
					local prop = getDungeonProps(floor)
					if prop then
						local pos
						pcall(function() pos = prop:GetPivot().Position end)
						if pos then
							if Player:DistanceFromCharacter(pos) > 10 then
								topos(CFrame.new(pos + Vector3.new(0, 5, 0)))
							else
								equipWeapon()
								autoHaki()
								local part = prop:FindFirstChildWhichIsA("BasePart", true) or prop
								local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
								if tool then pcall(function() tool:Activate() end) end
								local Net = getNet()
								local RA = Net and Net:FindFirstChild("RE/RegisterAttack")
								local RH = Net and Net:FindFirstChild("RE/RegisterHit")
								if RA and RH then
									pcall(function()
										RA:FireServer(0.01)
										RH:FireServer(part, {{prop, part}})
									end)
								end
							end
							task.wait(0.05)
							-- continue loop
						end
					end
				end

				-- wait briefly for enemies to load
				if #enemies == 0 then
					local t0 = tick()
					while tick() - t0 < 2 do
						task.wait(0.5)
						floor, floorIdx = getCurrentFloor()
						enemies = getFloorEnemies(floor)
						if #enemies > 0 then break end
					end
				end

				if #enemies > 0 then
					lastFloorIdx = floorIdx
					local target = enemies[1]
					local tr = target:FindFirstChild("HumanoidRootPart")
					if tr then
						local floorY = 0
						pcall(function() floorY = floor:GetPivot().Position.Y end)
						local offsetY = G.Distance or 20
						if tr.Position.Y > floorY + 100 then
							offsetY = 0
						end
						local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
						if tool and tool.ToolTip == "Blox Fruit" and tool.Name ~= "Ice-Ice" and tool.Name ~= "Light-Light" then
							offsetY = math.min(offsetY, 20)
						end
						topos(CFrame.new(tr.Position + Vector3.new(0, offsetY, 0)))
						equipWeapon()
						autoHaki()
						bringEnemies(target)
						attack(target)
						if G.FA then
							for i = 1, 4 do attack(target) end
						end
					end
				else
					-- advance to next floor exit
					if floorIdx <= lastFloorIdx or #enemies == 0 then
						local exit = getDungeonExit()
						if exit then
							if Player:DistanceFromCharacter(exit.Position) > 20 then
								topos(CFrame.new(exit.Position + Vector3.new(0, 10, 0)))
							end
						end
					end
				end
			end
			task.wait(0.05)
		else
			task.wait(0.2)
		end
	end
end)

